# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your key never gets committed.

# --- Ask Amson (the AI terminal) -------------------------------------------

# Required for AI answers. Create a key at https://platform.claude.com/settings/keys
# Without it the terminal still works, but only answers slash commands.
# Server-side only: never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Which Claude model answers. Defaults to claude-haiku-5-5 (fast and cheap).
ANTHROPIC_MODEL=

# Optional. Shared rate limiting across server instances with Upstash Redis.
# Leave both empty to use the built-in in-memory limiter.
# Create a free database at https://console.upstash.com and copy its REST values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
